{
  "name": "sms-ring",
  "version": "1.0.10",
  "private": true,
  "type": "module",
  "description": "Ring your phone at full volume with a secret SMS. Offline by design, open source.",
  "license": "MIT",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "dev": "rds exec -- vite",
    "build": "rds vue build",
    "preview": "rds exec -- vite preview",
    "typecheck": "rds exec -- vue-tsc --noEmit",
    "test": "rds exec -- node --test --experimental-strip-types tests/*.test.ts",
    "locales": "rds exec -- node scripts/generate-native-locales.mjs",
    "locales:check": "rds exec -- node scripts/generate-native-locales.mjs --check",
    "store:csv:android": "rds store export --platform android",
    "store:csv:ios": "rds store export --platform ios",
    "store": "rds store run --",
    "store:check": "rds store check",
    "store:check:strict": "rds store check --strict",
    "store:changelog": "rds store changelog",
    "ringtone": "rds exec -- node scripts/generate-ringtone.mjs",
    "verify:offline": "rds exec -- node scripts/verify-offline.mjs",
    "assets": "rds exec -- node scripts/generate-app-assets.mjs",
    "assets:web": "rds exec -- node scripts/generate-app-assets.mjs --web",
    "ios:setup-images": "rds exec -- node scripts/generate-ios-setup-images.mjs",
    "assets:check": "rds exec -- node scripts/generate-app-assets.mjs --check",
    "cap:sync": "rds capacitor sync",
    "cap:sync:android": "rds capacitor sync --platform android",
    "cap:sync:ios": "rds capacitor sync --platform ios",
    "cap:open:android": "rds capacitor open --platform android",
    "cap:open:ios": "rds capacitor open --platform ios",
    "cap:sync:open:android": "rds capacitor sync --platform android --open",
    "cap:sync:open:ios": "rds capacitor sync --platform ios --open",
    "native:versions": "rds capacitor versions",
    "ios:bump-build-number": "rds capacitor versions --platform ios --bump-build",
    "release:version": "rds capacitor versions --bump patch",
    "release:prepare:android": "node scripts/native-workflow.mjs release android",
    "release:prepare:android:open": "node scripts/native-workflow.mjs release android --open",
    "release:prepare:ios": "node scripts/native-workflow.mjs release ios",
    "release:prepare:ios:open": "node scripts/native-workflow.mjs release ios --open",
    "android:debug": "node scripts/native-workflow.mjs android debug",
    "android:install": "node scripts/native-workflow.mjs android install",
    "android:bundle": "node scripts/native-workflow.mjs android aab",
    "android:apk:release": "node scripts/native-workflow.mjs android apk",
    "android:start-adb": "rds android start-adb",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "capacitor-remote-ring": "*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "reusable-dev-scripts": "0.2.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
